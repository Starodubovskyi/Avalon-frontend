# Backend API base. Local dev: the Nest server; on Vercel: the backend deployment URL + /api/v1
NEXT_PUBLIC_API_URL=http://localhost:3020/api/v1
# Optional: target of the /api/v1 rewrite when NEXT_PUBLIC_API_URL is relative ("/api/v1")
API_PROXY_TARGET=http://localhost:3020
# Mapbox public token (pk.*), restrict it to your domains in the Mapbox dashboard
NEXT_PUBLIC_MAPBOX_TOKEN=
# Demo mode (in-browser mock backend with sample data, stored in localStorage):
#   off      - real backend only, no demo entry on the login page
#   fallback - default: real backend; "Explore the demo" on /auth, suggested when the server is down
#   only     - always demo, the app never calls the backend (static showcase deploys)
NEXT_PUBLIC_DEMO_MODE=fallback
